{
  "name": "scale-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visualizza le note di una scala sul manico della chitarra",
  "author": "Scale Finder",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:server\" \"npm:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -n SERVER,VITE,ELECTRON -c blue,green,yellow \"npm:server\" \"npm:client\" \"cross-env SF_DEV_URL=http://localhost:5173 electron .\"",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.1"
  }
}
